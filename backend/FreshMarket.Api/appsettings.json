{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "FreshMarket",
    "Audience": "FreshMarket",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "AdminRefreshDays": 7,
    "CustomerRefreshDays": 90
  },
  "Otp": {
    "DevMode": false,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "Pepper": ""
  },
  "Storage": {
    "Provider": "Database",
    "LocalRoot": "wwwroot/uploads",
    "PublicBasePath": "/uploads",
    "MaxBytes": 5242880
  },
  "Store": {
    "UtcOffsetMinutes": 330
  },
  "App": {
    "PublicUrl": ""
  },
  "Sms": {
    "Provider": "Log",
    "Fast2Sms": { "ApiKey": "", "Route": "q" },
    "Twilio": { "AccountSid": "", "AuthToken": "", "FromNumber": "" }
  },
  "Seed": {
    "Enabled": true
  },
  "Cors": {
    "Origins": []
  }
}
